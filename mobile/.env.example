EXPO_PUBLIC_API_URL=http://YOUR_WINDOWS_LAN_IP:8080/api/v1
# Public OIDC client using Authorization Code + PKCE. Never put a client secret in the app.
EXPO_PUBLIC_AUTH_ISSUER=https://YOUR_PROVIDER_ISSUER
EXPO_PUBLIC_AUTH_CLIENT_ID=YOUR_MOBILE_PUBLIC_CLIENT_ID
EXPO_PUBLIC_AUTH_AUDIENCE=cabinate-api
EXPO_PUBLIC_AUTH_SCOPES=openid profile offline_access cabinate:read cabinate:write

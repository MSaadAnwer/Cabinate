{
  "expo": {
    "name": "Cabinate",
    "slug": "cabinate",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "cabinate",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.cabinate.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Cabinate uses the camera for receipt and meal photos.",
        "NSPhotoLibraryUsageDescription": "Cabinate lets you choose receipt and meal photos.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#173E2D"
        }
      ],
      "expo-router",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Cabinate uses the camera for receipt and meal photos.",
          "photosPermission": "Cabinate lets you choose receipt and meal photos.",
          "microphonePermission": false
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      "expo-web-browser"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "298f22c4-2fee-4c67-bd09-9a3f247c8256"
      }
    },
    "owner": "cabinate"
  }
}

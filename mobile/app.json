{
  "expo": {
    "name": "Cabinate",
    "slug": "cabinate",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "cabinate",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.cabinate.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Cabinate uses the camera for receipt and meal photos.",
        "NSPhotoLibraryUsageDescription": "Cabinate lets you choose receipt and meal photos."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Cabinate uses the camera for receipt and meal photos.",
          "photosPermission": "Cabinate lets you choose receipt and meal photos.",
          "microphonePermission": false
        }
      ],
      "@react-native-community/datetimepicker"
    ]
  }
}
